# ==============================================================================
# Kodewaves Sovereign Voice AI — Environment Variables Template
# Copy to `.env` before running docker compose or ./install.sh:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Network Origin
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DOMAIN=localhost
PUBLIC_HOST=localhost
PUBLIC_BASE_URL=http://localhost:3010
BACKEND_API_ENDPOINT=http://localhost:8000
UI_APP_URL=http://localhost:3010

# Set to "false" to disable public signup (invite-only system)
ENABLE_SIGNUP=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Service Port Bindings (Collision-free, auto-detected during install)
# ------------------------------------------------------------------------------
UI_PORT=3010
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 3. Superadmin Credentials (Created automatically on first deployment)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@kodewaves.local
ADMIN_PASSWORD=change_this_admin_password_123

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL 17 with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_change_this_secret
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres_change_this_secret@postgres:5432/postgres

# ------------------------------------------------------------------------------
# 3. Cache & Queue (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=redis_change_this_secret
REDIS_URL=redis://:redis_change_this_secret@redis:6379

# ------------------------------------------------------------------------------
# 4. Kodewaves Sovereign Security & Master Credentials Vault
# ------------------------------------------------------------------------------
# MASTER_CREDENTIAL_ENCRYPTION_KEY: 32-byte Fernet base64 key for AES-256 encryption
# of platform-managed master API keys (OpenAI, Sarvam, Deepgram, Twilio, Exotel, etc.) at rest.
# Generate on Linux/Mac: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MASTER_CREDENTIAL_ENCRYPTION_KEY=k5Zp9mR8wX2yQ4tL7vN1jF3bH6aC8eD0sU2iO4gA6cY=

# OSS_JWT_SECRET: Secure random string used to sign local JWT auth tokens.
# Generate: openssl rand -hex 32
OSS_JWT_SECRET=kodewaves_jwt_secret_change_in_production_99a8b7c6d5e4f3a2

# Internal devops secret for health checks and deployment scripts
DOGRAH_DEVOPS_SECRET=kodewaves_devops_secret_change_me

# ------------------------------------------------------------------------------
# 5. Local Sovereign Audio Storage (MinIO S3-Compatible)
# ------------------------------------------------------------------------------
# Keeps all call recordings, agent greetings, and voice clips local & private.
ENABLE_AWS_S3=false
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_change_this_secret
MINIO_BUCKET=voice-audio
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 6. WebRTC NAT Traversal & Media Relay (Coturn STUN / TURN)
# ------------------------------------------------------------------------------
# Used for browser microphone voice testing ("Test Agent") behind strict NAT.
# Phone calls (Twilio/Plivo/Exotel) always stream over standard Port 443 WSS.
ENABLE_COTURN=true
TURN_HOST=localhost
TURN_SECRET=turn_change_this_shared_secret
TURN_PORT=3478
TURN_TLS_PORT=5349

# ------------------------------------------------------------------------------
# 7. Workers & Background Orchestrator
# ------------------------------------------------------------------------------
# Number of uvicorn FastAPI worker processes
FASTAPI_WORKERS=2

# Background services (keep true for standalone / aaPanel all-in-one nodes)
ENABLE_ARI_MANAGER=true
ENABLE_CAMPAIGN_ORCHESTRATOR=true

# ------------------------------------------------------------------------------
# 8. Frontend Next.js Configuration
# ------------------------------------------------------------------------------
PORT=3010
NODE_ENV=production
NEXT_PUBLIC_NODE_ENV=oss
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://api:8000
