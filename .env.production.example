# ==============================================================================
# Kodewaves Sovereign Voice AI — Production Environment (.env.production)
# Specifically configured for aaPanel, Cloud VPS, and Custom Domain Deployments
# 
# Quick Start:
# 1. cp .env.production.example .env
# 2. Update DOMAIN with your actual domain name (e.g., voice.yourdomain.com)
# 3. Generate secure secrets using openssl:
#    openssl rand -hex 24
# 4. Run installer or compose:
#    docker compose -f docker-compose.aapanel.yaml up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Network Origin (REPLACE WITH YOUR ACTUAL DOMAIN)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DOMAIN=voice.yourdomain.com
PUBLIC_HOST=voice.yourdomain.com
PUBLIC_BASE_URL=https://voice.yourdomain.com
BACKEND_API_ENDPOINT=https://voice.yourdomain.com
UI_APP_URL=https://voice.yourdomain.com

# User registration control
ENABLE_SIGNUP=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Superadmin Credentials (Initial platform administrator)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_secure_admin_password_16char

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL 17 with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password_32char
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_secure_postgres_password_32char@postgres:5432/postgres

# ------------------------------------------------------------------------------
# 3. Redis Cache & Job Queue (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_secure_redis_password_32char
REDIS_URL=redis://:replace_with_secure_redis_password_32char@redis:6379

# ------------------------------------------------------------------------------
# 4. Sovereign Master Key Vault & Auth Encryption
# ------------------------------------------------------------------------------
# 32-byte Fernet base64 key for AES-256 encryption of master provider keys at rest.
# MUST BE 32 URL-safe base64 bytes.
MASTER_CREDENTIAL_ENCRYPTION_KEY=k5Zp9mR8wX2yQ4tL7vN1jF3bH6aC8eD0sU2iO4gA6cY=

# JWT token signing secret for user authentication sessions
OSS_JWT_SECRET=replace_with_secure_jwt_secret_64char_hex_token

# DevOps internal secret
DOGRAH_DEVOPS_SECRET=replace_with_secure_devops_secret_token

# ------------------------------------------------------------------------------
# 5. Local Sovereign Storage (MinIO S3-Compatible)
# ------------------------------------------------------------------------------
ENABLE_AWS_S3=false
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://voice.yourdomain.com/voice-audio
MINIO_ROOT_USER=kodewavesadmin
MINIO_ROOT_PASSWORD=replace_with_secure_minio_password_32char
MINIO_BUCKET=voice-audio
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 6. WebRTC STUN / TURN Server (NAT Traversal)
# ------------------------------------------------------------------------------
ENABLE_COTURN=true
TURN_HOST=voice.yourdomain.com
TURN_SECRET=replace_with_secure_turn_shared_secret
TURN_PORT=3478
TURN_TLS_PORT=5349

# ------------------------------------------------------------------------------
# 7. Workers & High Availability
# ------------------------------------------------------------------------------
FASTAPI_WORKERS=2
ENABLE_ARI_MANAGER=true
ENABLE_CAMPAIGN_ORCHESTRATOR=true

# ------------------------------------------------------------------------------
# 8. Frontend Next.js Configuration
# ------------------------------------------------------------------------------
PORT=3010
NODE_ENV=production
NEXT_PUBLIC_NODE_ENV=oss
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_BACKEND_URL=https://voice.yourdomain.com
BACKEND_URL=http://api:8000
