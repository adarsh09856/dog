# ==============================================================================
# Kodewaves Sovereign Voice AI Platform — Canonical Environment Configuration
# ==============================================================================
# This template documents EVERY environment variable consumed across the API,
# workers, and telephony pipelines (including the 53 previously undocumented keys).
#
# Rule: Master provider credentials stored in the encrypted database vault
# (/api/v1/admin/master-keys) ALWAYS take precedence over environment fallbacks.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Public Network Routing
# ------------------------------------------------------------------------------
# Environment mode: 'production', 'development', or 'test'
ENVIRONMENT="production"
DEPLOYMENT_MODE="oss"
KODEWAVES_ENV="production"
KODEWAVES_INSTANCE="kodewaves-node-1"

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Enable self-service user registrations (set to false for invite-only deployment)
ENABLE_SIGNUP="true"

# Public Canonical URLs — MUST include scheme (https:// or http://) and match DNS
# Incorrect values will break carrier webhooks, OAuth callbacks, and WebRTC signaling.
DOMAIN="your-domain.com"
PUBLIC_HOST="your-domain.com"
PUBLIC_BASE_URL="https://your-domain.com"
BACKEND_API_ENDPOINT="https://your-domain.com"
UI_APP_URL="https://your-domain.com"
UI_INTERNAL_URL="http://ui:3010"

# CORS Allowed Origins: comma-separated list of origins or '*' for development
CORS_ALLOWED_ORIGINS="https://your-domain.com"

# Reverse Proxy & Header Trust: trust X-Forwarded-* headers from nginx/aaPanel
FORWARDED_ALLOW_IPS="*"

# ------------------------------------------------------------------------------
# 2. Database, Cache & Concurrency Controls
# ------------------------------------------------------------------------------
# PostgreSQL connection string (asyncpg driver required)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-postgres-password"
POSTGRES_DB="postgres"
DATABASE_URL="postgresql+asyncpg://postgres:change-me-postgres-password@postgres:5432/postgres"

# Redis cache and task queue connection string
REDIS_PASSWORD="change-me-redis-password"
REDIS_URL="redis://:change-me-redis-password@redis:6379"

# Concurrency Limits (Admin configurable in DB, environment sets baseline)
DEFAULT_ORG_CONCURRENCY_LIMIT="10"
MAX_CONCURRENT_CALLS="50"
local_ai_max_concurrency="2"

# Worker Scaling: FASTAPI_WORKERS is auto-derived from CPU cores if set to 'auto'
FASTAPI_WORKERS="auto"
ARQ_WORKERS="1"
ASGI_WORKER_ID="1"

# ------------------------------------------------------------------------------
# 3. Sovereign Vault Encryption & Authentication
# ------------------------------------------------------------------------------
# AES-256 Fernet 32-byte base64 encryption key for securing master keys in DB.
# Generate via: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MASTER_CREDENTIAL_ENCRYPTION_KEY="k5Zp9mR8wX2yQ4tL7vN1jF3bH6aC8eD0sU2iO4gA6cY="
KODEWAVES_SECRET_KEY="k5Zp9mR8wX2yQ4tL7vN1jF3bH6aC8eD0sU2iO4gA6cY="

# JWT Session Secret & Token Expiry
OSS_JWT_SECRET="change-me-to-a-secure-random-jwt-secret-key-at-least-32-chars"
JWT_SECRET="change-me-to-a-secure-random-jwt-secret-key-at-least-32-chars"
OSS_JWT_EXPIRY_HOURS="720"

# Authentication Provider: 'local' (built-in email/password) or 'stack'
AUTH_PROVIDER="local"
# Stack Auth credentials (if AUTH_PROVIDER="stack"):
STACK_AUTH_API_URL=""
STACK_AUTH_PROJECT_ID=""
STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""

# Internal DevOps Secret: protects rolling updates and admin container hooks
KODEWAVES_DEVOPS_SECRET="change-me-devops-management-secret"
DOGRAH_DEVOPS_SECRET="change-me-devops-management-secret"

# Initial Superadmin bootstrap credentials (created on first startup)
ADMIN_EMAIL="admin@kodewaves.com"
ADMIN_PASSWORD="change-me-admin-password"

# ------------------------------------------------------------------------------
# 4. Security & Telephony Guardrails
# ------------------------------------------------------------------------------
# CRITICAL SECURITY INVARIANT: NEVER set to true in production!
# Installer and API lifespan REFUSE to boot in production if this is true.
SKIP_TELEPHONY_SIGNATURE_VERIFICATION="false"

# Carrier Webhook & Media Socket Capability Tokens
TELEPHONY_WS_TOKEN_SECRET=""
TELEPHONY_WS_TOKEN_ENFORCE="false"

# Background Telephony & Campaign Loops
ENABLE_ARI_MANAGER="false"
ENABLE_ARI_STASIS="false"
ENABLE_CAMPAIGN_ORCHESTRATOR="false"

# ------------------------------------------------------------------------------
# 5. Local Storage (MinIO) & Audio Recording Management
# ------------------------------------------------------------------------------
ENABLE_AWS_S3="false"
MINIO_ENDPOINT="minio:9000"
MINIO_PUBLIC_ENDPOINT="https://your-domain.com/voice-audio"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="change-me-minio-password"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="change-me-minio-password"
MINIO_BUCKET="voice-audio"
MINIO_SECURE="false"

# Upload post-call user/bot mix recordings to MinIO
ENABLE_CALL_RECORDING_UPLOAD="true"

# ------------------------------------------------------------------------------
# 6. WebRTC NAT Traversal (Coturn STUN / TURN)
# ------------------------------------------------------------------------------
ENABLE_COTURN="true"
TURN_HOST="your-domain.com"
TURN_SECRET="change-me-coturn-shared-secret"
TURN_USERNAME="kodewaves"
TURN_PASSWORD="change-me-coturn-shared-secret"
TURN_PORT="3478"
TURN_TLS_PORT="5349"
TURN_CREDENTIAL_TTL="86400"
FORCE_TURN_RELAY="false"

# ------------------------------------------------------------------------------
# 7. Sovereign Local CPU AI Engine (Ollama + Piper + Whisper)
# ------------------------------------------------------------------------------
ENABLE_LOCAL_AI_ENGINE="true"
OLLAMA_ENDPOINT="http://ollama:11434"
PIPER_ENDPOINT="http://piper:5000"
WHISPER_ENDPOINT="http://whisper:8000/v1"

# ------------------------------------------------------------------------------
# 8. Outbound Webhook Delivery & Retries
# ------------------------------------------------------------------------------
WEBHOOK_DELIVERY_BASE_DELAY_SECONDS="1.0"
WEBHOOK_DELIVERY_MAX_ATTEMPTS="5"
WEBHOOK_DELIVERY_MAX_DELAY_SECONDS="60.0"
WEBHOOK_DELIVERY_TIMEOUT_SECONDS="10.0"

# ------------------------------------------------------------------------------
# 9. Logging, Observability & Error Tracking
# ------------------------------------------------------------------------------
LOG_FILE_PATH="logs/kodewaves.log"
LOG_ROTATION_SIZE="20 MB"
LOG_RETENTION="30 days"
LOG_COMPRESSION="zip"
SERIALIZE_LOG_OUTPUT="false"
ENABLE_TURN_LOGGING="false"

# Error Tracking (Optional)
SENTRY_DSN=""
ENABLE_TELEMETRY="false"
ENABLE_PROMETHEUS_METRICS="false"

# Documentation & Audio Prompt Tuner paths
KODEWAVES_DOCS_PATH="./docs"
TUNER_BASE_URL=""

# ------------------------------------------------------------------------------
# 10. Payment Gateways (Bootstrap Only — DB Settings Take Precedence)
# ------------------------------------------------------------------------------
# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 11. Legacy Environment Provider Fallbacks (Master Vault in DB is Preferred)
# ------------------------------------------------------------------------------
# Cloud provider keys configured in Admin Panel -> Master Keys are stored in DB.
# Environment fallback is supported for bootstrap development only:
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
DEEPGRAM_API_KEY=""
CARTESIA_API_KEY=""
ELEVENLABS_API_KEY=""
AZURE_SPEECH_REGION=""
GENDERAPI_API_KEY=""
GENDER_API_KEY=""
