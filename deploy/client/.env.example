# Copy to .env in this directory and fill every placeholder before starting.
# Image values must be approved immutable references ending in @sha256:<digest>.
CLIENT_API_IMAGE=registry.example.com/kodewaves/client-api@sha256:<api-digest>
CLIENT_UI_IMAGE=registry.example.com/kodewaves/client-ui@sha256:<ui-digest>
CLIENT_POSTGRES_IMAGE=registry.example.com/kodewaves/postgres-pgvector@sha256:<postgres-digest>
CLIENT_REDIS_IMAGE=registry.example.com/kodewaves/redis@sha256:<redis-digest>
CLIENT_MINIO_IMAGE=registry.example.com/kodewaves/minio@sha256:<minio-digest>
CLIENT_COTURN_IMAGE=registry.example.com/kodewaves/coturn@sha256:<coturn-digest>
# Required only when COMPOSE_PROFILES includes direct-ingress; otherwise leave blank.
CLIENT_CADDY_IMAGE=

# Per-service CPU and memory ceilings; these are not reservations, minimum
# hardware requirements, or a performance guarantee. With default direct ingress
# enabled, all seven ceilings sum to about 4.75 CPU cores / 4.75 GiB; without
# Caddy, the other six sum to about 4.5 CPU cores / 4.5 GiB. Leave host capacity
# for Linux, Docker and other services. Cloud or separately hosted inference is
# the lower-memory profile. An owner-approved package can include the optional
# local model profile below; its model-specific CPU, RAM and GPU/VRAM limits
# require a full-installation load test. No latency or concurrency is certified.
# CLIENT_CADDY_CPUS=0.25
# CLIENT_CADDY_MEMORY_LIMIT=256m
# CLIENT_POSTGRES_CPUS=1.0
# CLIENT_POSTGRES_MEMORY_LIMIT=1g
# CLIENT_REDIS_CPUS=0.5
# CLIENT_REDIS_MEMORY_LIMIT=256m
# CLIENT_MINIO_CPUS=0.5
# CLIENT_MINIO_MEMORY_LIMIT=512m
# CLIENT_COTURN_CPUS=0.5
# CLIENT_COTURN_MEMORY_LIMIT=256m
# CLIENT_API_CPUS=1.5
# CLIENT_API_MEMORY_LIMIT=2g
# CLIENT_UI_CPUS=0.5
# CLIENT_UI_MEMORY_LIMIT=512m

# Starts the bundled HTTPS ingress. Clear this value to use an existing proxy.
COMPOSE_PROFILES=direct-ingress
# Add self-hosted for bundled local inference: direct-ingress,self-hosted.
# Requires >=16 GiB RAM plus model download storage; 8 GiB hosts should use
# cloud or separate inference. CPU latency depends on hardware/model/language.
CLIENT_SELF_HOSTED_MEMORY_GIB=16
# Owner-pinned model images; blank in cloud-only packages. All four required
# when self-hosted is selected. Never substitute :latest or a mutable tag.
CLIENT_OLLAMA_IMAGE=
CLIENT_INDIC_STT_IMAGE=
CLIENT_INDUS_TTS_IMAGE=
CLIENT_INDIC_VITS_TTS_IMAGE=
CLIENT_OLLAMA_MODEL=qwen3.5:2b-q4_K_M
CLIENT_STT_LANGUAGES=all
CLIENT_STT_PREWARM_LANGUAGES=en,hi

# Keep these values aligned for the bundled Caddy ingress. The API trusts
# X-Forwarded-* headers only from this fixed proxy address.
CLIENT_INTERNAL_SUBNET=172.30.0.0/24
CLIENT_CADDY_IPV4=172.30.0.2
FORWARDED_ALLOW_IPS=172.30.0.2

# If using an existing reverse proxy instead of direct-ingress, set
# FORWARDED_ALLOW_IPS to that proxy's peer IP/CIDR as seen by the API container.
# Never set it to '*'.

# Copy the signed manifest for this exact API image into this directory.
CLIENT_RELEASE_MANIFEST_FILE=./client-release-manifest.json

# Values issued by Kodewaves for this installation.
KODEWAVES_INSTALLATION_ID=<installation-id>
KODEWAVES_LICENSE_TOKEN=<owner-signed-license-token>
# Owner revocation/IP status refresh interval in seconds (bounded to 1–3600).
# Keep the default for production; CI shortens it to verify signed deny/recovery.
KODEWAVES_OWNER_STATUS_POLL_SECONDS=60
PUBLIC_HOST=voice.customer.example.com

# For an enrolled identity, use an absolute host key path and a nonzero group
# that may read the key. The enrollment command creates the key once locally.
CLIENT_IDENTITY_KEY_FILE=
CLIENT_IDENTITY_GID=

# TURN_HOST is the server's public IP as seen by WebRTC clients (not a URL).
TURN_HOST=<server-public-ip>

# Generate unique secrets. Use a URL-safe-base64 32-byte key for the credential key.
POSTGRES_PASSWORD=<random-secret>
REDIS_PASSWORD=<random-secret>
MINIO_ROOT_USER=kodewaves-storage
MINIO_ROOT_PASSWORD=<random-secret>
OSS_JWT_SECRET=<random-secret-of-at-least-32-characters>
MASTER_CREDENTIAL_ENCRYPTION_KEY=<url-safe-base64-encoded-32-byte-key>
# During key rotation, set previous Fernet key(s), comma-separated. Installers
# may also preserve old JWT-derived decrypt-only values as legacy-b64:<value>.
# Re-save provider settings / migrate workflow overrides before removing keys.
MASTER_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
TELEPHONY_WS_TOKEN_SECRET=<random-secret>
TURN_SECRET=<random-secret>

# Optional local-only published ports. These bind to 127.0.0.1.
API_PORT=8000
UI_PORT=3010
MINIO_PORT=9000
