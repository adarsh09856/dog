{
	admin off
}

{$PUBLIC_HOST} {
	encode zstd gzip

	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy api:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@audio path /voice-audio /voice-audio/*
	handle @audio {
		reverse_proxy minio:9000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy ui:3010 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
